# Build / dependencies
node_modules/
dist/
*.tsbuildinfo

# Python bytecode / caches (scripts/ci reviewer + scripts/hooks)
__pycache__/
*.pyc
.pytest_cache/

# Local env / secrets (never commit)
.env
.env.*
!.env.example

# Test / report artifacts (auto-generated)
client/e2e-results.json
client/playwright-report/
client/test-results/
client/e2e/_minimal-*.png
client/e2e/_probe-*.png
shipwright_audit_report.json

# === .shipwright/ Artefakt-Whitelist (kongruent zum Monorepo) ===
# Alles ignorieren, nur die kanonischen SDLC-Doku-Heimaten freigeben.
/.shipwright/*
!/.shipwright/adopt/
!/.shipwright/agent_docs/
!/.shipwright/compliance/
!/.shipwright/designs/
!/.shipwright/planning/
# Transiente / interne / generierte Inhalte wieder ausschliessen:
/.shipwright/adopt/backups/
/.shipwright/adopt/screenshots/
/.shipwright/agent_docs/visual/
/.shipwright/agent_docs/runtime/
/.shipwright/agent_docs/triage-remaining-iterates-handoff.md
/.shipwright/compliance/skill-compliance/

# === Root shipwright_* Self-Adoption-State ===
# Default: ignorieren. Ausnahmen: persistente Configs/Events werden bewusst getrackt.
shipwright_*_config.json
shipwright_test_results.json
shipwright_events.jsonl
shipwright_events.jsonl.lock
!/shipwright_*_config.json
!/shipwright_test_results.json
!/shipwright_events.jsonl

# Root-Locks (multi-writer State)
# All sidecar markdown lockfiles (CHANGELOG.md.lock, agent_docs/*.md.lock, …).
# Placed after the .shipwright/agent_docs/ whitelist so it still ignores locks there.
*.md.lock
CHANGELOG.md.lock
shipwright_run_config.json.lock
.shipwright_toolcall_count

# Lokale Git-Worktrees nie committen
/.worktrees/

# Isolated USERPROFILE used by iterate F0.5 E2E (not part of any source set)
/.e2e-userprofile/

# Throwaway PoC/debug screenshots from client E2E exploration (not a source set)
client/e2e/.poc-screenshots/

# Lokaler VS-Code-Multi-Root-Workspace
/.shipwright-webui/

# Local launch-prep / one-shot scrub tooling
/.scrub.py

# Lokaler Konzept-/Prototyp-Scratchpad (Mockups, Audits, HTML-Prototyp,
# Screenshots) — vollstaendig lokal, NIE im Repo. /Spec/prototype/ allein sind
# 43 MB Binaries, die jeder Klon mitziehen wuerde. Bis 2026-07-30 griff hier
# KEINE Regel: der Ordner war nur zufaellig nie eingecheckt, ein `git add .`
# haette ihn hineingezogen. Die eine Ausnahme, die es gab
# (Spec/design/2026-07-17-fr-taxonomy-regrouping.md, PR #287), ist mit dieser
# Regel bewusst wieder entfernt worden — Spec/ ist ausnahmslos lokal. Verweise
# aus aelteren Iterate-Specs auf Spec/**-Pfade sind damit absichtlich
# unaufloesbar (sie waren es fuer Prototyp-Pfade ohnehin schon).
/Spec/

# === BEGIN Shipwright canonical .shipwright artifact-ignore (managed) ===
# Managed by Shipwright (adopt/project). Do not hand-edit — re-running
# /shipwright-adopt or /shipwright-project back-fills missing rules.
# SSoT: shared/templates/shipwright-gitignore.template
!/.shipwright/triage.jsonl
/.shipwright/triage.outbox.jsonl
**/.shipwright/locks/
/.shipwright/compliance/audit-report.md
/.shipwright/compliance/audit-report.json
/.shipwright/planning/iterate/**/external_review_state.json
/.shipwright/planning/iterate/**/external_code_review_state.json
/.shipwright/planning/iterate/campaigns/
/.shipwright/triage.outbox.quarantine.jsonl
/.shipwright/designs/design-feedback-round*.md
/.shipwright/agent_docs/iterates/*.plan.json
/.shipwright/agent_docs/iterates/*.phase_timings.jsonl
/.shipwright/compliance/evidence/
/.shipwright/compliance/test-evidence-index.json
/.shipwright/planning/adr/*.tmp
/.shipwright/agent_docs/iterates/*.iterate_timings.jsonl
/.shipwright/agent_docs/iterates/*.iterate_timings.jsonl.lock
/.shipwright/agent_docs/iterates/*.test-results.json.*.tmp
/.shipwright/compliance/context-cost/
/.shipwright/agent_docs/*.tmp
/.shipwright/agent_docs/decision-drops/INDEX.md
/.shipwright/agent_docs/decision-drops/*.tmp
/.shipwright/agent_docs/decision-drops-legacy-pending-scan/
# === END Shipwright canonical .shipwright artifact-ignore (managed) ===

# Triage Inbox (shipwright)
.shipwright/triage.jsonl.lock
.shipwright/triage.jsonl.bak

# Test coverage output (produced transiently in CI, uploaded as an artifact —
# never committed). Feeds the diff-coverage gate (client + server cobertura).
**/coverage/
