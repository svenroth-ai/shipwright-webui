+  it("on POSIX with no real uv on any candidate PATH dir, falls back to the bare name (spawn then yields the honest ENOENT)", async () => {
+    const out = await resolveUv({
+      run: async () => ({ ok: true, stdout: "uv 0.11.9", stderr: "" }),
